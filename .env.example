# Copiá este archivo como .env.local (en tu compu) y cargá las mismas variables en Vercel.

# URL pública del sitio, sin barra final. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://luxuryfadestudio.com.ar

# Mercado Pago → Tus integraciones → tu aplicación → Credenciales.
# Para probar usá el Access Token de la cuenta vendedora de prueba.
MP_ACCESS_TOKEN=
# Mercado Pago → tu aplicación → Webhooks → "Clave secreta".
MP_WEBHOOK_SECRET=

# Webhook de n8n o Make que recibe las reservas (CRM + WhatsApp).
AUTOMATION_WEBHOOK_URL=

# Upstash Redis. Si la conectás desde Vercel (Storage → Upstash), Vercel carga
# KV_REST_API_URL y KV_REST_API_TOKEN solo y estas dos pueden quedar vacías.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
